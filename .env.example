# Copy to .env next to docker-compose.yml. No real credentials in this file or the repo.

# image to run; empty = build it from this checkout
DEMO_IMAGE=
# host port of the demo
DEMO_PORT=2567
# WebSocket URL of the demo as the browser sees it; empty = same host and port as the page
# (e.g. wss://office.example.com behind an HTTPS reverse proxy that forwards WebSockets)
PUBLIC_SERVER_URL=

# LiveKit (video chat); all empty = video chat off
# LIVEKIT_URL is the URL the browser uses, e.g. wss://livekit.example.com
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# only for `docker compose --profile livekit`: public IP of the host, LiveKit image tag
LIVEKIT_NODE_IP=
LIVEKIT_VERSION=latest
