{
  "name": "skyoffice",
  "version": "1.0.0",
  "private": true,
  "description": "An immersive virtual office",
  "license": "MIT",
  "author": "kevinshen56714",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinshen56714/SkyOffice.git"
  },
  "type": "module",
  "workspaces": [
    "types",
    "packages/media",
    "server",
    "client-3d"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client-3d\"",
    "dev:server": "npm run dev -w server",
    "dev:client3d": "npm run dev -w client-3d",
    "dev:livekit": "livekit-server --dev",
    "build": "npm run build -w server && npm run build -w client-3d",
    "build:server": "npm run build -w server",
    "build:client3d": "npm run build -w client-3d",
    "start": "npm start -w server",
    "start:demo": "STATIC_DIR=\"$PWD/client-3d/dist\" npm start",
    "extract-map": "npm run extract-map -w client-3d",
    "bots": "node client-3d/scripts/bots.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --coverage",
    "smoke": "node client-3d/scripts/smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.3"
  }
}
